#include<bits/stdc++.h>
using namespace std;
//topo sort- scheduling for directed acyclic graph , if graph is cyclic we are simply returning empty vector{}
bool dfs(int i,vector<vector<int>> &adj,vector<int> &vis,vector<int> &ans,vector<int> pathvis){
    vis[i]=1;
    pathvis[i]=1; //for cycle detection
    for(auto it:adj[i]){
        if(pathvis[it]){
            return false;
        }
        if(!vis[it]){
            if(!dfs(it,adj,vis,ans,pathvis)) return false;
        }
    }
    ans.push_back(i);
    pathvis[i]=0;
    return true;
}
vector<int> topologicalSort(vector<vector<int>>& adj){
    int n=adj.size();
    vector<int> ans;
    vector<int> vis(n,0);
    vector<int> pathvis(n,0);
    for(int i=0;i<n;i++){
        if(!vis[i]){
            if(!dfs(i,adj,vis,ans,pathvis)) return {};
        }
    }
    reverse(ans.begin(),ans.end());
    return ans;
}

//cycle detection in directed graph
//using dfs
//TC->O(V+E) SC->O(2V+V(recursion stack space))
bool dfs(int i,vector<int> &vis,vector<int> &ans,vector<vector<int>> &adj,vector<int> pathvis){
    vis[i]=1;
    pathvis[i]=1;
    for(auto it:adj[i]){
        if(!vis[it]){
            if(dfs(it,vis,ans,adj,pathvis)){
                return true;
            }
        }
        else if(pathvis[it]) return true;
    }
    pathvis[i]=0;
    return false;
}

bool isCyclic(int V, vector<vector<int>> adj) {
    vector<int> ans;
    vector<int> pathvis(V,0);
    vector<int> vis(V,0);
    
    for(int i=0;i<V;i++){
        if(!vis[i]){
            if(dfs(i,vis,ans,adj,pathvis)) return true;
        }
    }
    return false;
}
//using bfs
bool isCyclic(int V, vector<vector<int>> adj) {
    vector<int> indegree(V);
    for(int i=0;i<V;i++){
        for(auto it:adj[i]){
            indegree[it]++;
        }
    }
    queue<int> q;
    for(int i=0;i<V;i++){
        if(indegree[i]==0){
            q.push(i);
        }
    }
    int cnt=0; //count elements in ans vector(imaginary) no need currently as we don't have to give order of scheduling
    while(!q.empty()){
        int front=q.front();
        q.pop();
        for(auto it:adj[front]){
            indegree[it]--;
            if(indegree[it]==0){
                q.push(it);
            }
        }
        cnt++;
    }
    if(cnt!=V) return true;
    return false;
}

