vector<int> spath_directedacyclic1(vector<vector<int>> adj){
    int n=adj.size();
    vector<int> indegree(n,0);
    for(int i=0;i<n;i++){
        for(auto it:adj[i]){
            indegree[it]++;
        }
    }
    queue<int> q;
    for(int i=0;i<n;i++){
        if(indegree[i]==0){
            q.push(i);
        }
    }
    vector<int> order;
    while(!q.empty()){
        int front=q.front();
        q.pop();
        order.push_back(front);
        for(auto it:adj[front]){
            indegree[it]--;
            if(indegree[it]==0) q.push(it);
        }
    }
    
    vector<int> dist(n,INT_MAX);
    dist[order[0]]=0;
    for(auto it:order){
        for(auto i:adj[it]){
            if(dist[i]==INT_MAX) dist[i]=dist[it]+1;
        }
    }
    return dist;
}

