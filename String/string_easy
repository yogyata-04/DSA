//Remove outermost paranthesis
//TC->O(n+n) SC->O(n)
string removeouterpara(string str){
    string ans;
    int n=str.size();
    int left=0;
    int open=0;
    int close=0;
    for(int i=0;i<n;i++){
        if(str[i]=='(') open++;
        if(str[i]==')') close++;
        if(open==close){
            for(int j=left+1;j<i;j++){
                ans+=str[j];
            }
            left=i+1;
        }
    }
    return ans;
}

//Reverse words in a string
//e.g.->Input s="the sky is blue" Output: "blue is sky the"
//We have inbuilt stl function as well that can help us for converting string of several words as in e.g. to vector of words
//TC->O(n) SC->O(no. of words + n(for ans string))
vector<string> splitstring(string str){
    vector<string> ans;
    
    //STL function - TC->O(n)
    istringstream iss(str);  // Create a string stream ->O(1)
    string word;
    // Extract words from the stream and store them in the vector
    while (iss >> word) {
        ans.push_back(word);
    }
    
    return ans;
}

