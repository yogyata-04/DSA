typedef long long ll;

//Pascal's triangle
//TC->O(n^3) SC->O(n*(n+1)/2)
int ncr(int n,int r){
    int ans=1;
    for(int i=1;i<=r;i++){
        ans*=(n-i+1);
        ans/=i;
    }
    return ans;
}

vector<vector<int>> pascaltriangle(int n){
    vector<vector<int>> ans;
    for(int i=0;i<n;i++){
        vector<int> temp;
        for(int j=0;j<=i;j++){
            temp.push_back(ncr(i,j));
        }
        ans.push_back(temp);
    }
    return ans;
}

//majority element >n/3 times
//TC->O(n+n) SC->O(1)
pair<int,int> majority3(vector<int> vec){
    int n=vec.size();
    int el1=INT_MIN,el2=INT_MIN;
    int cnt1=0,cnt2=0;
    for(int i=0;i<n;i++){
        if(vec[i]==el1) cnt1++;
        else if(vec[i]==el2) cnt2++;
        else{
            if(cnt1==0) {el1=vec[i];cnt1++;}
            else if(cnt2==0) {el2=vec[i];cnt2++;}
            else{
                cnt1--;
                cnt2--;
            }
        }
    }
    cnt1=0;
    cnt2=0;
    for(int i=0;i<n;i++){
        if(vec[i]==el1) cnt1++;
        if(vec[i]==el2) cnt2++;
    }
    pair<int,int> p={-1,-1};
    if(cnt1>n/3) p.first=el1;
    if(cnt2>n/3) p.second=el2;
    return p;
}

//3 sum arr[i]+arr[j]+arr[k]=req_val
//brute TC->O(n^3) SC->O(2*no. of unique triplets)
//better solution TC->O(n^2*log(no.of unique triplets)) SC->O(2*no. of unique triplets)
vector<vector<int>> threesum(vector<int> vec,int req_sum){
    set<vector<int>> s;
    map<int,int> mp; //val,ind
    int n=vec.size();
    for(int i=0;i<n;i++){
        set<int> st;
        for(int j=i+1;j<n;j++){
            int req=req_sum-vec[i]+vec[j];
            if(st.find(req)!=st.end()){
                vector<int> temp={vec[i],vec[j],req};
                sort(temp.begin(),temp.end());
                s.insert(temp);
            }
            st.insert(vec[j]);
        }
    }
    vector<vector<int>> ans;
    int m=s.size();
    for(auto it:s){
        ans.push_back(it);
    }
    return ans;
}
//optimised approach
//TC->O(nlogn+n^2) SC->O(no. of triplets)
vector<vector<int>> threeSum(vector<int>& vec,int req_sum) {
    vector<vector<int>> ans;
    sort(vec.begin(),vec.end());
    int n=vec.size();
    int i=0;
    for(int i=0;i<n;i++){
        if(i!=0 && vec[i]==vec[i-1]) continue;
        //simply question becomes two sum now
        int j=i+1;
        int k=n-1;
        int req=req_sum-vec[i];
        while(j<k){
            if(vec[j]+vec[k]==req){
                ans.push_back({vec[i],vec[j],vec[k]});
                j++;
                k--;
                while(j<k && vec[j]==vec[j-1]) {j++;}
                while(j<k && vec[k]==vec[k+1]) {k--;}
            }
            else if(vec[j]+vec[k]>req){
                k--;
            }
            else{
                j++;
            }
        }   
    }
    return ans;
}

//4 sum arr[i]+arr[j]+arr[k]+arr[l]=req_val
//TC->O(n^3log(no. of triplets)) SC->O(2*no.of triplets)
vector<vector<int>> fourSum(vector<int>& vec, int req_sum) {
    int n=vec.size();
    set<vector<int>> s;
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            set<int> st;
            for(int k=j+1;k<n;k++){
                long long int req=(long long)req_sum-((long long)vec[i]+(long long)vec[j]+(long long)vec[k]);
                if(req>INT_MAX || req<INT_MIN) continue;
                if(st.find(req)!=st.end()){
                    vector<int> temp={vec[i],vec[j],vec[k],(int)req};
                    sort(temp.begin(),temp.end());
                    s.insert(temp);
                }
                st.insert(vec[k]);
            }
        }
    }
    vector<vector<int>> ans(s.begin(),s.end());
    return ans;
}
//optimised
//TC->O(n^3+nlogn) SC->O(no. of unique triplets)
//remember to remove redundancy and long long depending on input size as range of int is Minimum: −2.147×10^9 to maximum: 2.147×10^9
vector<vector<int>> fourSum(vector<int>& vec, int req_sum) {
    int n=vec.size();
    vector<vector<int>> ans;
    sort(vec.begin(),vec.end());
    for(int i=0;i<n;i++){
        if(i!=0 && vec[i]==vec[i-1]) continue;
        for(int j=i+1;j<n;j++){
            // now it simply becomes 2 sum
            if(j!=i+1 && vec[j]==vec[j-1]) continue;
            int k=j+1;
            int l=n-1;
            ll req=(ll)req_sum-(ll)(vec[i]+vec[j]);
            while(k<l){
                if((ll)(vec[k]+vec[l])==req){
                    ans.push_back({vec[i],vec[j],vec[k],vec[l]});
                    k++;
                    l--;
                    while(k<l && vec[k]==vec[k-1]) {k++;}
                    while(k<l && vec[l]==vec[l+1]) {l--;}
                }
                else if(vec[k]+vec[l]<req) k++;
                else l--;
            }
        }
    }
    return ans;
}

//largest subarray with 0 sum
//TC->O(nlogn) SC->O(n)
//Remember here we will not add element in map if it already exists as maximum length is asked
int maxLen(vector<int>& arr) {
    // code here
    int maxlen=0;
    int n=arr.size();
    int sum=0;
    int req_sum=0;
    map<int,int> mp;
    mp[0]=-1;
    for(int i=0;i<n;i++){
        sum+=arr[i];
        int req=sum-req_sum;
        if(mp.find(req)!=mp.end()){
            maxlen=max(maxlen,i-mp[req]);
        }
        if(mp.find(sum)==mp.end()) mp[sum]=i;
    }
    return maxlen;
}

//count subarrays with given xor k
//TC->O(nlogn) SC->O(n)
int xorsubarrays(vector<int> &arr, int req_xor_sum) {
    int ans=0;
    int n=arr.size();
    int xor_sum=0;
    map<int,int> mp;
    mp[0]=1;
    for(int i=0;i<n;i++){
        xor_sum^=arr[i];
        int req=xor_sum^req_xor_sum;
        if(mp.find(req)!=mp.end()){
            ans+=mp[req];
        }
        mp[xor_sum]++;
    }
    return ans;
}

