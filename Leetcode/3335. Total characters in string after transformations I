// Return the length of the resulting string after exactly t transformations. If the character is 'z', replace it with the string "ab".
Otherwise, replace it with the next character in the alphabet.

//TC-> O(26*t+n+26) where n=size of array

class Solution {
int mod=1e9+7;  
public:
    int lengthAfterTransformations(string s, int t) {
        vector<int> vec(26,0);
        int n=s.size();
        for(int i=0;i<n;i++){
            vec[s[i]-'a']++;
        }
        while(t--){
            vector<int> next(26,0);
            for(int i=1;i<26;i++){
                next[i]=vec[i-1];
            }
            next[0]=vec[25];
            next[1]=(next[1]+vec[25]%mod)%mod;
            vec=next;
        }
        int ans=0;

        for(int i=0;i<26;i++){
            ans=(ans+vec[i])%mod;
        }
        return ans;
    }
};

// here we can also take unordered map to reduce space complexity but as it is 26 so doesn't matter much.
