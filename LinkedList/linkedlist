// 32 Bit System	    64 Bit System
// Int - 4 Bytes	    Int - 4 Bytes
// Pointer - 4 Bytes	Pointer - 8 Bytes
// Overall - 8 Bytes	Overall - 12 Bytes
class node{
    public:
        int val;
        node* next;
        node(int data){
            val=data;
            next=NULL;
        }
        node(){
            val=0;
            next=NULL;
        }
};

//constructing a new linked list
//TC->O(n) SC->O(n)
node* constructll(vector<int> arr){
    int n=arr.size();
    if(n==0) NULL;
    node* root=new node(arr[0]);
    node* temp=root;
    for(int i=1;i<n;i++){
        temp->next=new node(arr[i]);
        temp=temp->next;
    }
    return root;
}

//print linked list
void printll(node* head){
    while(head){
        cout<<head->val<<" ";
        head=head->next;
    }
}

//insert node in linked list at end (easy only) TC->O(n) SC->O(1)

//inserting head 
void insertathead(node* &head,int x){
    if(head==NULL) return;
    node* newhead=new node(x);
    newhead->next=head;
    head=newhead;
}

