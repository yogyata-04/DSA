//remember the case when next node is null for pth position node
Node *addNode(Node *head, int pos, int data) {
    Node* temp=head;
    if(pos==0){
        Node* temp1=new Node(data);
        temp1->next=head;
        head->prev=temp1;
        return temp1;
    }
    for(int i=0;i<pos;i++){
        temp=temp->next;
    }
    Node* tmp=temp->next;
    //adding new node
    temp->next=new Node(data);
    temp->next->prev=temp;
    //making connections with tmp node
    if(tmp!=NULL){
        temp=temp->next;
        temp->next=tmp;
        tmp->prev=temp;
    }
    return head;
}

// Function to delete a node with given value.
//Remember edge cases when node can be head or tail
//TC->O(n) SC->O(1)
Node* deleteNode(Node* head, int x) {
    Node* temp=head;
    while(temp){
        if(temp->data==x){
            //tail case
            if(temp->next==NULL) {
                temp->prev->next=NULL;
                delete(temp);
                return head;
            }
            //head case
            if(temp->prev==NULL){
                temp->next->prev=NULL;
                head=temp->next;
                delete(temp);
                return head;
            }
            temp->next->prev=temp->prev;
            temp->prev->next=temp->next;
            delete(temp);
            return head;
        }
        temp=temp->next;
    }
    return head;
}

